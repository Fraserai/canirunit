{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CanIRunAI",
  "version": "0.1.0",
  "identifier": "com.canirunai.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CanIRunAI",
        "width": 1180,
        "height": 820,
        "minWidth": 940,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
